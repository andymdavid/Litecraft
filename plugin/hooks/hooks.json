{
  "description": "LiteCraft originals guard: asks the user before anything moves, renames, overwrites or deletes original photos.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_litecraft_lightcraft__.*|Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "timeout": 15,
            "onFailure": "block",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh"
            ]
          }
        ]
      }
    ]
  }
}
