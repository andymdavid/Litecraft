#!/bin/bash
# MCP server for the LiteCraft plugin (see plugin/.mcp.json).
# Always connect mode: drives the running LightCraft desktop app, never opens
# the library itself, so the app and Claude never fight over the library lock.
# The server starts even if the app isn't running yet and connects on first call.
set -euo pipefail

LITECRAFT_HOME="${LITECRAFT_HOME:-$HOME/LiteCraft}"
ENV_FILE="$LITECRAFT_HOME/litecraft.env"
# Read litecraft.env as data — never `source` it, so a value can't run as shell code.
read_env_file() {
  local k v
  [[ -f "$1" ]] || return 0
  while IFS='=' read -r k v || [[ -n "$k" ]]; do
    v="${v%\"}"; v="${v#\"}"; v="${v%\'}"; v="${v#\'}"
    case "$k" in
      LIGHTCRAFT_CLI|LIGHTCRAFT_APP|LITECRAFT_LIBRARY|LITECRAFT_PORT) printf -v "$k" '%s' "$v" ;;
    esac
  done < "$1"
}
read_env_file "$ENV_FILE"
[[ "${LITECRAFT_PORT:-7980}" =~ ^[0-9]+$ ]] || LITECRAFT_PORT=7980

CLI="${LIGHTCRAFT_CLI:-}"
if [[ -z "$CLI" || ! -x "$CLI" ]]; then
  CLI="$(command -v lightcraft-cli || true)"
fi
if [[ -z "$CLI" ]]; then
  echo "LiteCraft: LightCraft isn't installed yet — run /litecraft:setup, then reconnect this server with /mcp." >&2
  exit 1
fi

# --compact: the ~28 helper tools only (vs ~600, one per command); run_command reaches the rest.
exec "$CLI" mcp --compact --connect "127.0.0.1:${LITECRAFT_PORT:-7980}"
